# Environment Configuration - Smart Artisan Companion (SIH26090)

# Project Information
PROJECT_NAME="Smart Artisan Companion"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
PORT=8000
HOST="0.0.0.0"
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
DATABASE_URL="sqlite:///./artisan_companion.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/artisan_db"

# AI Vision & Voice Settings
BHASHINI_API_KEY="mock-bhashini-api-key"
BHASHINI_USER_ID="mock-user-id"
GEMINI_API_KEY="your-google-gemini-api-key"
WHISPER_MODEL_SIZE="base"

# ONDC (Beckn Protocol) Configuration
ONDC_GATEWAY_URL="https://staging.gateway.proteantech.in"
ONDC_BAP_ID="buyer-app-network.ondc.org"
ONDC_BPP_ID="artisan-bpp.brocode.sih.in"
ONDC_BPP_URI="http://localhost:8000/api/ondc"
ONDC_SIGNING_PRIVATE_KEY="mock-ed25519-private-key"
ONDC_SUBSCRIBER_ID="artisan-network-provider"

# Redis Cache (Optional for dev)
REDIS_URL="redis://localhost:6379/0"
