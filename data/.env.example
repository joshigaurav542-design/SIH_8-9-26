# Database Configuration for Prisma & Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=artisan123
POSTGRES_DB=artisan_db
POSTGRES_PORT=5432

# Connection string for Prisma running on host machine
DATABASE_URL="postgresql://postgres:artisan123@localhost:5432/artisan_db?schema=public"

