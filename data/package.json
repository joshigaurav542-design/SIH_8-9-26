{
  "name": "artisan-companion-data",
  "version": "1.0.0",
  "description": "Database layer using Docker and Prisma for Smart Artisan Companion (SIH 2026)",
  "main": "seed.js",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio --port 5555 --hostname 0.0.0.0",
    "seed": "node seed.js",
    "db:setup": "prisma db push && node seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}
